# ---- Needed by the app (public, safe in the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server only (Netlify environment variables, never in the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Texting (optional — leave blank until Twilio is approved) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE of these two:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
